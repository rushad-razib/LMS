generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  SET_PASSWORD
  REFRESH
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BatchStatus {
  UPCOMING
  ONGOING
  CLOSED
}

enum OrderChannel {
  ONLINE
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  CANCELLED
}

enum AdminPaymentMethod {
  CASH
  CARD
  SSLCOMMERZ_OFFLINE
  OTHER
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String?
  fullName        String
  role            Role
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  studentProfile StudentProfile?
  tokens         AuthToken[]
  taughtBatches  Batch[]     @relation("BatchTeacher")
  orders         Order[]
  enrollments    Enrollment[]
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, type])
}

/// Singleton row id = "default"
model WebsiteSettings {
  id                        String   @id @default("default")
  emailVerificationRequired Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  overview    String       @db.Text
  duration    String
  priceBdt    Int
  outlineText String?      @db.Text
  faqText     String?      @db.Text
  status      CourseStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  batches     Batch[]
  orders      Order[]
  enrollments Enrollment[]
}

model Batch {
  id              String      @id @default(cuid())
  courseId        String
  name            String
  scheduleSummary String?     @db.Text
  status          BatchStatus @default(UPCOMING)
  teacherId       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  course         Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher        User?               @relation("BatchTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments    Enrollment[]
  liveSessions   LiveSession[]
  materials      BatchMaterial[]
  announcements  BatchAnnouncement[]

  @@index([courseId])
  @@index([teacherId])
}

model LiveSession {
  id         String    @id @default(cuid())
  batchId    String
  title      String
  startsAt   DateTime
  endsAt     DateTime?
  meetingUrl String    @db.Text
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([startsAt])
}

model BatchMaterial {
  id         String   @id @default(cuid())
  batchId    String
  title      String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  url        String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model BatchAnnouncement {
  id        String   @id @default(cuid())
  batchId   String
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model Order {
  id            String              @id @default(cuid())
  userId        String
  courseId      String
  amountBdt     Int
  channel       OrderChannel
  status        OrderStatus         @default(PENDING)
  paymentMethod AdminPaymentMethod?
  provider      String?
  providerRef   String?
  tranId        String              @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollment Enrollment?

  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  courseId  String
  orderId   String?          @unique
  batchId   String?
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  batch  Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([batchId])
  @@index([status])
}
