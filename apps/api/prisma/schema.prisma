generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  SET_PASSWORD
  REFRESH
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BatchStatus {
  UPCOMING
  ONGOING
  CLOSED
}

enum BatchDeliveryMode {
  ONLINE
  OFFLINE
}

enum OrderChannel {
  ONLINE
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  CANCELLED
}

enum AdminPaymentMethod {
  CASH
  CARD
  SSLCOMMERZ_OFFLINE
  OTHER
}

enum InstallmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  DUE
  PAID
  OVERDUE
}

enum StudentGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String?
  fullName        String
  role            Role
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  studentProfile  StudentProfile?
  teacherProfile  TeacherProfile?
  tokens          AuthToken[]
  taughtBatches   Batch[]           @relation("BatchTeacher")
  orders          Order[]
  enrollments     Enrollment[]
  installmentPlans InstallmentPlan[]
}

model StudentProfile {
  id             String         @id @default(cuid())
  userId         String         @unique
  phone          String?
  whatsappPhone  String?
  dateOfBirth    DateTime?      @db.Date
  gender         StudentGender?
  nidNumber      String?
  addressLine    String?
  city           String?
  district       String?
  guardianName   String?
  guardianPhone  String?
  educationLevel String?
  occupation     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  phone      String?
  title      String?
  bio        String?  @db.Text
  photoKey   String?
  photoUrl   String?  @db.Text
  cvKey      String?
  cvFileName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, type])
}

/// Singleton row id = "default"
model WebsiteSettings {
  id                        String   @id @default("default")
  emailVerificationRequired Boolean  @default(true)
  siteName                  String?
  headerLogoKey             String?
  headerLogoUrl             String?  @db.Text
  footerLogoKey             String?
  footerLogoUrl             String?  @db.Text
  footerCopyright           String?  @db.Text
  contactPhone              String?
  contactEmail              String?
  address                   String?  @db.Text
  businessHours             String?  @db.Text
  whatsappNumber            String?
  facebookUrl               String?  @db.Text
  instagramUrl              String?  @db.Text
  youtubeUrl                String?  @db.Text
  mapEmbedHtml              String?  @db.Text
  announcementBar           String?  @db.Text
  updatedAt                 DateTime @updatedAt
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String    @db.Text
  bodyHtml       String    @db.LongText
  coverImageKey  String?
  coverImageUrl  String?   @db.Text
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, publishedAt])
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String?
  imageKey  String
  imageUrl  String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model GlobalNotice {
  id          String    @id @default(cuid())
  title       String
  body        String    @db.Text
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model MarketingTrainer {
  id        String   @id @default(cuid())
  fullName  String
  title     String?
  bio       String?  @db.Text
  photoKey  String?
  photoUrl  String?  @db.Text
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

model Lead {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([createdAt])
  @@index([readAt])
}

model Course {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique
  overview       String       @db.Text
  duration       String
  priceBdt       Int
  outlineText    String?      @db.Text
  faqText        String?      @db.Text
  coverImageKey  String?
  coverImageUrl  String?      @db.Text
  status         CourseStatus @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  batches          Batch[]
  orders           Order[]
  enrollments      Enrollment[]
  installmentPlans InstallmentPlan[]
}

model Batch {
  id              String            @id @default(cuid())
  courseId        String
  name            String
  scheduleSummary String?           @db.Text
  status          BatchStatus       @default(UPCOMING)
  deliveryMode    BatchDeliveryMode @default(ONLINE)
  seatCapacity    Int               @default(30)
  startDate       DateTime?
  endDate         DateTime?
  teacherId       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  course         Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher        User?               @relation("BatchTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments    Enrollment[]
  liveSessions   LiveSession[]
  materials      BatchMaterial[]
  announcements  BatchAnnouncement[]

  @@index([courseId])
  @@index([teacherId])
}

model LiveSession {
  id         String    @id @default(cuid())
  batchId    String
  title      String
  startsAt   DateTime
  endsAt     DateTime?
  meetingUrl String    @db.Text
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([startsAt])
}

model BatchMaterial {
  id         String   @id @default(cuid())
  batchId    String
  title      String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  url        String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model BatchAnnouncement {
  id        String   @id @default(cuid())
  batchId   String
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model Order {
  id            String              @id @default(cuid())
  userId        String
  courseId      String
  amountBdt     Int
  channel       OrderChannel
  status        OrderStatus         @default(PENDING)
  paymentMethod AdminPaymentMethod?
  provider      String?
  providerRef   String?
  tranId        String              @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollment  Enrollment?
  installment Installment?

  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model Enrollment {
  id            String           @id @default(cuid())
  userId        String
  courseId      String
  orderId       String?          @unique
  batchId       String?
  status        EnrollmentStatus @default(ACTIVE)
  accessBlocked Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  batch           Batch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  installmentPlan InstallmentPlan?

  @@unique([userId, courseId])
  @@index([batchId])
  @@index([status])
}

model InstallmentPlan {
  id           String                @id @default(cuid())
  enrollmentId String                @unique
  userId       String
  courseId     String
  totalBdt     Int
  months       Int
  graceDays    Int                   @default(10)
  status       InstallmentPlanStatus @default(ACTIVE)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  enrollment  Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  installments Installment[]

  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model Installment {
  id            String            @id @default(cuid())
  planId        String
  sequence      Int
  amountBdt     Int
  dueDate       DateTime
  payByDate     DateTime
  status        InstallmentStatus @default(DUE)
  paidAt        DateTime?
  paymentMethod AdminPaymentMethod?
  orderId       String?           @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  plan  InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  order Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([planId, sequence])
  @@index([status])
  @@index([dueDate])
  @@index([payByDate])
}
