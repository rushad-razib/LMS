# Database (MySQL)
DATABASE_URL=mysql://root@localhost:3306/lms

# API
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Auth (change in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=AR Visionary Academy <onboarding@resend.dev>

# S3-compatible storage (optional in local/dev — empty values use disk under apps/api/uploads)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Public API origin for payment callbacks (e.g. https://lms.rushadrazib.com).
# Falls back to WEB_ORIGIN when empty (typical cPanel SPA + API on same host).

# SSLCommerz (sandbox: SSLCOMMERZ_IS_LIVE=false)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# App
APP_NAME=AR Visionary Academy

# Public site URL used in sitemap/canonicals when building the web app (optional; defaults to production host)
# VITE_SITE_URL=https://lms.rushadrazib.com
# Google Analytics (optional — leave empty to disable)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXX
# Google Search Console HTML meta verification (optional)
# VITE_GSC_VERIFICATION=

# Daily cron (cPanel): POST /api/v1/internal/installment-reminders with header x-cron-secret
CRON_SECRET=

# Seed admin (pnpm --filter @arva/api db:seed)
ADMIN_EMAIL=admin@arva.local
ADMIN_PASSWORD=Admin12345!
ADMIN_NAME=Site Admin
